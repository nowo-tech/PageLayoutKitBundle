{#
  BC bridge (deprecated since 2.1, removed in 3.0): wraps a 2.0 host admin layout (web_ui.layout_template) that
  renders `{% block admin %}` (and `title`, `page_title`, `stylesheets`, `javascripts`) instead of the UiKit canonical
  blocks. PageLayoutKitPages::layout() selects it when the configured layout does not define nowo_ui_page_header.
  Canonical blocks the 2.0 layout already renders (nowo_page_layout_kit_legacy_blocks, e.g. nowo_ui_flashes /
  nowo_ui_content of a copy of the 2.0 bundle layout) are not printed a second time.
  Variables: nowo_page_layout_kit_legacy_layout, nowo_page_layout_kit_legacy_blocks.
#}
{% extends nowo_page_layout_kit_legacy_layout %}
{% set _host_blocks = nowo_page_layout_kit_legacy_blocks|default([]) %}

{% block title %}{{ block('nowo_ui_document_title') }}{% endblock %}
{% block page_title %}{{ block('nowo_ui_document_title') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if 'nowo_ui_styles' not in _host_blocks %}{{ block('nowo_ui_styles') }}{% endif %}
    {{ block('nowo_ui_head') }}
{% endblock %}

{% block admin %}
    {% set _bundle = nowo_ui_bundle|default(null) %}
    <div class="{{ nowo_ui_class('content', _bundle) }}"{% if _bundle %} data-nowo-ui-bundle="{{ _bundle }}"{% endif %}>
        {{ block('nowo_ui_page_header') }}
        {% if 'nowo_ui_flashes' not in _host_blocks %}{{ block('nowo_ui_flashes') }}{% endif %}
        {% if 'nowo_ui_content' not in _host_blocks %}{{ block('nowo_ui_content') }}{% endif %}
    </div>
    {% if 'nowo_ui_modals' not in _host_blocks %}{{ block('nowo_ui_modals') }}{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if 'nowo_ui_scripts' not in _host_blocks %}{{ block('nowo_ui_scripts') }}{% endif %}
{% endblock %}

{#- Canonical block defaults (the page / scaffold overrides them; a 2.0 layout that renders one of them gets these) -#}
{% block nowo_ui_document_title %}{% endblock %}
{% block nowo_ui_head %}{% endblock %}
{% block nowo_ui_styles %}<link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">{{ nowo_ui_tokens() }}{% endblock %}
{% block nowo_ui_page_header %}{% endblock %}
{% block nowo_ui_flashes %}{{ include(nowo_ui_partial('flashes', nowo_ui_bundle|default(null)), {bundle: nowo_ui_bundle|default(null)}) }}{% endblock %}
{% block nowo_ui_content %}{% endblock %}
{% block nowo_ui_modals %}{% endblock %}
{% block nowo_ui_scripts %}{{ include(nowo_ui_partial('scripts', nowo_ui_bundle|default(null))) }}{% endblock %}
