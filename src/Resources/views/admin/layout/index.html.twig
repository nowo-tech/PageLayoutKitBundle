{#
  Reorder screen of one page (REQ-UI-003): UiKit form scaffold. Variables: page (View\FormPage from
  PageLayoutKitPages::layoutPage(): header admin.layout.title / admin.layout.lead with the "View page" action, the
  reorder form, submit admin.layout.save_order; body-only mode without entries), layout_table (View\Table from
  PageLayoutKitPages::layoutTable(): columns position / type / id, row action Edit), layout_empty (View\EmptyState).
  Data block filled: nowo_ui_form_body (the entries table with one position field per row, else the empty state).
  The controller also passes page_title, page_key, entries, reorder_form and view_page_url for host templates set
  through web_ui.templates.layout_index.
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoPageLayoutKitBundle' %}

{% block nowo_ui_form_body %}
    {% if form is not null and layout_table.rows is not empty %}
        {% embed nowo_ui_partial('table', bundle) with {table: layout_table, bundle: page.bundle, rows_form: form.rows, nowo_ui_page_type: nowo_ui_page_type} only %}
            {% block nowo_ui_table_row %}
                {% set _row_form = rows_form[row_key] %}
                <td class="{{ nowo_ui_class('table_cell', bundle) }}" data-label="{{ 'admin.layout.position'|trans({}, 'NowoPageLayoutKitBundle') }}" data-required="1">
                    {% for child in _row_form %}
                        {% if child.vars.name == 'id' %}
                            {{ form_widget(child) }}
                        {% else %}
                            {{ form_label(child, 'admin.layout.position', {label_attr: {class: 'visually-hidden'}}) }}
                            {{ form_widget(child, {attr: child.vars.attr|merge({class: nowo_ui_class('input', bundle)})}) }}
                            {{ form_errors(child) }}
                        {% endif %}
                    {% endfor %}
                </td>
                <td class="{{ nowo_ui_class('table_cell', bundle) }}" data-label="{{ 'admin.layout.type'|trans({}, 'NowoPageLayoutKitBundle') }}"><span class="{{ nowo_ui_class('badge_neutral', bundle) }}">{{ row.blockType.value }}</span></td>
                <td class="{{ nowo_ui_class('table_cell', bundle) }}" data-label="{{ 'admin.layout.id'|trans({}, 'NowoPageLayoutKitBundle') }}" data-nowo-ui-priority="2"><code class="{{ nowo_ui_class('code', bundle) }}">#{{ row.blockId }}</code></td>
            {% endblock %}
        {% endembed %}
    {% else %}
        {{ include(nowo_ui_partial('empty', page.bundle), {empty: layout_empty, bundle: page.bundle, region: 'empty', nowo_ui_page_type: nowo_ui_page_type}, false) }}
    {% endif %}
{% endblock %}
