{#
  Deprecated since 2.1, removed in 3.0 (REQ-UI-003): the 2.0 default admin layout. The bundle pages extend UiKit
  scaffolds and no longer use it; it is kept for templates that still extend the deprecated `nowo_page_layout_kit_layout`
  global (copies of the 2.0 reorder / block pages) and fill `title`, `page_title` and `admin`. It extends the UiKit
  admin layout (`nowo_ui_kit.layouts.admin`) instead of shipping its own HTML shell, so it loads no CSS framework.
#}
{% extends nowo_ui_layout.admin %}
{% trans_default_domain 'NowoPageLayoutKitBundle' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'admin.title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_page_header %}
    <header class="{{ nowo_ui_class('page_header') }}">
        <h1 class="{{ nowo_ui_class('page_title') }}">{% block page_title %}{{ 'admin.title'|trans }}{% endblock %}</h1>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block admin %}{% endblock %}{% endblock %}
