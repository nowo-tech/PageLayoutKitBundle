<div class="before-after" style="margin-top:2rem">
  <div class="before-after__col before-after__col--before">
    <p class="before-after__label">{{ data.beforeLabel }}</p>
    <div class="card__text legal-content">{{ data.beforeText|raw }}</div>
  </div>
  <div class="before-after__col before-after__col--after">
    <p class="before-after__label">{{ data.afterLabel }}</p>
    <div class="card__text legal-content">{{ data.afterText|raw }}</div>
  </div>
</div>
