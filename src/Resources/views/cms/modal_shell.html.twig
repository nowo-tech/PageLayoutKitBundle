{#
  Inline CMS modal chrome, rendered once in the host page (REQ-UI-003): the UiKit `dialog` partial (native <dialog>)
  with the `cms-modal` Stimulus targets — modal (the dialog), title, body (the form fetched from
  /admin/page-blocks/{type}/{id}/edit-modal) and submit. cms_modal_controller.ts opens it with showModal() and resets
  it on `close` (Escape, the close / cancel buttons through UiKit's nowo-ui-dialog.js). Loads UiKit's dialog and tabs
  runtimes (idempotent if the host loads them too). Labels: cms.edit_block, cms.cancel, cms.save (host domain).
#}
{% set _b = 'NowoPageLayoutKitBundle' %}
{% set _footer %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close data-action="cms-modal#close">{{ 'cms.cancel'|trans }}</button>
    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}" form="cms-modal-active-form" data-cms-modal-target="submit" disabled>{{ 'cms.save'|trans }}</button>
{% endset %}
{{ include(nowo_ui_partial('dialog', _b), {
    id: 'cms-modal',
    title: 'cms.edit_block'|trans,
    size: 'lg',
    bundle: _b,
    attr: {'data-cms-modal-target': 'modal'},
    title_attr: {'data-cms-modal-target': 'title'},
    body_attr: {'data-cms-modal-target': 'body'},
    close_label: 'cms.close'|trans,
    footer: _footer,
}, false) }}
{{ include(nowo_ui_partial('scripts', _b), {script_names: ['dialog', 'tabs']}) }}
