# PHPStan configuration for Page Layout Kit Bundle
# Compatible with PHP 8.2+ and Symfony 7.x / 8.x

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    # REQ-CS-006: never silence findings here — fix the code instead.
    ignoreErrors: []

services:
    -
        class: Nowo\PageLayoutKitBundle\Tests\PHPStan\DoctrineGeneratedIdPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
