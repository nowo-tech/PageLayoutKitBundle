{
  "name": "nowo-tech/page-layout-kit-bundle",
  "private": true,
  "description": "Build and unit tests for the Page Layout Kit Bundle inline CMS modal Stimulus controller",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
