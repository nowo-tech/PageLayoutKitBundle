{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo; the bundle's
    admin screens reach it through nowo_ui_kit.layouts.admin. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Page Layout Kit',
    home_route: 'home',
    repository: 'https://github.com/nowo-tech/PageLayoutKitBundle',
    translation_domain: false,
    auth: {login_route: 'app_login', logout_route: 'app_logout'},
    nav: [
        {label: 'Home', route: 'home', section: 'Public pages'},
        {label: 'Contact', route: 'contact', section: 'Public pages'},
        {label: 'Admin home', route: 'admin_page_layout', params: {pageKey: 'home'}, section: 'Admin', testid: 'demo-nav-admin_page_layout-home'},
        {label: 'Admin contact', route: 'admin_page_layout', params: {pageKey: 'contact'}, section: 'Admin', testid: 'demo-nav-admin_page_layout-contact'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Page Layout Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
