<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Page Layout Kit Demo{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('home') }}">Page Layout Kit Bundle · Symfony 8</a>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-outline-light" href="{{ path('home') }}">Home</a>
            <a class="btn btn-sm btn-outline-light" href="{{ path('contact') }}">Contact</a>
            <a class="btn btn-sm btn-outline-light" href="{{ path('admin_page_layout', {pageKey: 'home'}) }}">Admin home</a>
            <a class="btn btn-sm btn-outline-light" href="{{ path('admin_page_layout', {pageKey: 'contact'}) }}">Admin contact</a>
            {% if app.user %}
                <a class="btn btn-sm btn-warning" href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a class="btn btn-sm btn-primary" href="{{ path('app_login') }}">Login</a>
            {% endif %}
        </div>
    </div>
</nav>
<main class="container pb-5">
    {% block body %}{% endblock %}
</main>
</body>
</html>
